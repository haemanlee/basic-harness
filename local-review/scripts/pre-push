#!/usr/bin/env bash
set -euo pipefail

HARNESS_HOME="${CLAUDE_REVIEW_HOME:-$HOME/.claude-local-review}"
REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_NAME="$(basename "$REPO_ROOT")"
STATE_FILE="$HARNESS_HOME/state/$REPO_NAME/last-review.env"
HEAD_SHA="$(git rev-parse HEAD)"

printf '\n[ai-review] pre-push check\n'

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  printf '[ai-review] warning: working tree has uncommitted tracked changes; they are not part of this push.\n'
fi

if [ -f "$STATE_FILE" ]; then
  # shellcheck disable=SC1090
  source "$STATE_FILE"
else
  HEAD_SHA_REVIEWED=""
  RESULT=""
fi

if [ "${HEAD_SHA_REVIEWED:-${HEAD_SHA:-}}" = "$HEAD_SHA" ]; then
  case "${RESULT:-}" in
    PASS)
      printf '[ai-review] already reviewed: PASS\n'
      exit 0
      ;;
    WARN)
      printf '[ai-review] already reviewed: P2 warning only; push allowed.\n'
      exit 0
      ;;
    BLOCK)
      printf '[ai-review] last review contains P0/P1 findings. Push blocked.\n'
      printf '[ai-review] fix findings and run ai-review again, or intentionally bypass with git push --no-verify.\n'
      exit 1
      ;;
  esac
fi

printf '[ai-review] current HEAD has not been reviewed. Running review now...\n'
if "$HARNESS_HOME/scripts/ai-review.sh"; then
  source "$STATE_FILE"
  if [ "${RESULT:-}" = WARN ]; then
    printf '[ai-review] P2 findings detected; push allowed with warning.\n'
  else
    printf '[ai-review] review passed; continuing push.\n'
  fi
  exit 0
else
  code=$?
  if [ "$code" -eq 2 ]; then
    printf '[ai-review] P0/P1 findings detected. Push blocked.\n'
    printf '[ai-review] bypass only when necessary: git push --no-verify\n'
    exit 1
  fi
  printf '[ai-review] review failed unexpectedly (exit %s). Push blocked to avoid silently skipping review.\n' "$code"
  printf '[ai-review] bypass if needed: git push --no-verify\n'
  exit "$code"
fi
